# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Models — see https://docs.tokenfactory.nebius.com/
CENTRI_EMBEDDING_MODEL=BAAI/bge-en-icl
CENTRI_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
CENTRI_LLM_MODEL_SYNTHESIS=meta-llama/Meta-Llama-3.1-70B-Instruct

# Tavily (optional — used for time-sensitive synthetic query expansion)
TAVILY_API_KEY=

# Paths
CENTRI_AGENT_CATALOG=sample_agent_router_dataset.json
CENTRI_COMPILED_DIR=data/compiled

# Routing
CENTRI_TOP_K_VECTORS=25
CENTRI_TOP_K_AGENTS_RERANK=3
CENTRI_VECTOR_CANDIDATES=3
CENTRI_QUERIES_PER_AGENT=50
