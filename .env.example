# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Models — see https://docs.tokenfactory.nebius.com/
CENTRI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
CENTRI_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CENTRI_LLM_MODEL_SYNTHESIS=nvidia/nemotron-3-super-120b-a12b

# Tavily (optional — used for time-sensitive synthetic query expansion)
TAVILY_API_KEY=

# Security. Keep auth disabled only for local development.
CENTRI_AUTH_REQUIRED=false
CENTRI_JWT_SECRET=replace-with-a-long-random-secret
CENTRI_JWT_ALGORITHM=HS256

# Paths
CENTRI_AGENT_CATALOG=sample_agent_router_dataset.json
CENTRI_COMPILED_DIR=data/compiled
CENTRI_AGENT_ENDPOINTS_JSON={}

# Routing
CENTRI_TOP_K_VECTORS=25
CENTRI_TOP_K_AGENTS_RERANK=3
CENTRI_VECTOR_CANDIDATES=3
CENTRI_QUERIES_PER_AGENT=50
CENTRI_MAX_INTENT_SHARDS=4
CENTRI_ROUTE_MIN_SIMILARITY=0.35
CENTRI_ROUTE_MIN_MARGIN=0.03
CENTRI_RUNTIME_TIMEOUT_SECONDS=30
CENTRI_MOCK_EXECUTION=true

# Index: flat is the exact evaluation baseline; hnsw is the scalable default.
CENTRI_INDEX_TYPE=hnsw
CENTRI_HNSW_M=32
CENTRI_HNSW_EF_SEARCH=64
CENTRI_HNSW_EF_CONSTRUCTION=80

# Telemetry
CENTRI_LOG_RETENTION_DAYS=30
CENTRI_REDACT_TELEMETRY=true
