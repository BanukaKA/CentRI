    },
    {
      "id": "text-108",
      "type": "text",
      "x": 1245,
      "y": 1745,
      "width": 980,
      "height": 40.5,
      "angle": 0,
      "strokeColor": "#243247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 855252,
      "version": 1,
      "versionNonce": 11310732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A micro-LLM sees only Top-K schemas and the query.\nIt resolves payroll \u2194 HR, support \u2194 security, and other collisions.",
      "originalText": "A micro-LLM sees only Top-K schemas and the query.\nIt resolves payroll \u2194 HR, support \u2194 security, and other collisions.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "fontWeight": "400"
    },
    {
      "id": "text-109",
      "type": "text",
      "x": 1245,
      "y": 1815,
      "width": 181.44,
      "height": 21.6,
      "angle": 0,
      "strokeColor": "#dc2626",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 863171,
      "version": 1,
      "versionNonce": 11415461,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Theoretical guardrail",
      "originalText": "Theoretical guardrail",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "fontWeight": "700"
    },
    {
      "id": "text-110",
      "type": "text",
      "x": 1245,
      "y": 1850,
      "width": 980,
      "height": 40.5,
      "angle": 0,
      "strokeColor": "#243247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 871090,
      "version": 1,
      "versionNonce": 11520190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Retrieval recall@K bounds what reranking can recover.\nNo reranker can select an agent absent from the candidate set.",
      "originalText": "Retrieval recall@K bounds what reranking can recover.\nNo reranker can select an agent absent from the candidate set.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "fontWeight": "400"
    },
    {
      "id": "text-111",
      "type": "text",
      "x": 1245,
      "y": 1910,
      "width": 1000,
      "height": 18.900000000000002,
      "angle": 0,
      "strokeColor": "#20304a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 879009,
      "version": 1,
      "versionNonce": 11624919,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Therefore measure: recall@K \u00b7 top-1 accuracy \u00b7 abstention \u00b7 ECE \u00b7 p95 latency \u00b7 cost/request",
      "originalText": "Therefore measure: recall@K \u00b7 top-1 accuracy \u00b7 abstention \u00b7 ECE \u00b7 p95 latency \u00b7 cost/request",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "fontWeight": "700"
    },
