    },
    {
      "id": "text-106",
      "type": "text",
      "x": 1245,
      "y": 1640,
      "width": 980,
      "height": 40.5,
      "angle": 0,
      "strokeColor": "#243247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 839414,
      "version": 1,
      "versionNonce": 11101274,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cheap bi-encoder embeddings retrieve a small candidate pool.\nPrecomputed agent examples preserve open-world coverage.",
      "originalText": "Cheap bi-encoder embeddings retrieve a small candidate pool.\nPrecomputed agent examples preserve open-world coverage.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "fontWeight": "400"
    },
    {
      "id": "text-107",
      "type": "text",
      "x": 1245,
      "y": 1710,
      "width": 198.72000000000003,
      "height": 21.6,
      "angle": 0,
      "strokeColor": "#7c3aed",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
