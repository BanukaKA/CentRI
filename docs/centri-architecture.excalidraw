      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ANN retrieval (HNSW / IVF-PQ) + calibrated rerank + abstain\nsublinear-like behavior is a target to benchmark, not a theorem",
      "originalText": "ANN retrieval (HNSW / IVF-PQ) + calibrated rerank + abstain\nsublinear-like behavior is a target to benchmark, not a theorem",
