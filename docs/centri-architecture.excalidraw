    },
    {
      "id": "text-105",
      "type": "text",
      "x": 1245,
      "y": 1605,
      "width": 172.8,
      "height": 21.6,
      "angle": 0,
      "strokeColor": "#16a34a",
      "backgroundColor": "transparent",
